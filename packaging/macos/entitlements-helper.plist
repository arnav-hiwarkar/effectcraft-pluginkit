<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for craft-plugin-helper, the process that loads native plug-in
     libraries. Library validation is off because those libraries are signed by their authors, not
     by this app's team; the helper runs under the sandbox profile built in craft-plugin-host. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
